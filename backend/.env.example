# Servidor
PORT=4000
NODE_ENV=development

# Base de datos (PostgreSQL)
DATABASE_URL=postgres://usuario:password@localhost:5432/mta_crud_login

# JWT
JWT_ACCESS_SECRET=tu_jwt_access_secret_aqui
JWT_REFRESH_SECRET=tu_jwt_refresh_secret_aqui
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# OAuth Google
GOOGLE_CLIENT_ID=tu_client_id_de_google
GOOGLE_CLIENT_SECRET=tu_client_secret_de_google
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# OAuth GitHub
GITHUB_CLIENT_ID=tu_client_id_de_github
GITHUB_CLIENT_SECRET=tu_client_secret_de_github
GITHUB_CALLBACK_URL=http://localhost:4000/api/auth/github/callback

# Correo (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_email@gmail.com
SMTP_PASS=tu_contraseña_de_aplicacion
EMAIL_FROM="MTA Software <tu_email@gmail.com>"

# URL del frontend
FRONTEND_URL=http://localhost:5173